 10  REM SALES REPORT
 12  FOR I=1 TO 3
 15  READ N$(I),ASALES(I),BSALES(I)
 18  DATA ERIC,6,8,RON,9,5,JEFF,4,12
 21  ACOM(I)=125 * ASALES(I)
