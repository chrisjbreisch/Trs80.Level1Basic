 10  INPUT "NUMBER OF ELEMENTS IN THE ARRAY"; N
 20  DIM S(N)
 30  FOR I=1 TO N
 34  INPUT S(I)
 38  NEXT I
 40  REM ASSUME THE LARGEST ELEMENT IS S(1)
 42  BIG=S(1)
 50  FOR I=2 TO N
 52  IF S(I)<=BIG THEN 58
 54  REM S(I) IS LARGER THAN THE PREVIOUS LARGEST ELEMENT
 56  BIG=S(I)
 58  NEXT I
 60  PRINT "THE LARGEST ELEMENT IS"; BIG
