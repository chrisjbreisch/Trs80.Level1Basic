 10  REM  AVERAGE A SET OF NUMBERS
 20  PRINT "HOW MANY NUMBERS DO YOU WISH TO AVERAGE?"
 30  INPUT N
 40  REM  INITIALIZE THE SUM TO ZERO
 45  SUM=0
 50  FOR K=1 TO N
 60  INPUT "ENTER A NUMBER", NUMBER
 70  SUM=SUM+NUMBER
 80  NEXT K
 95  PRINT "THE AVERAGE OF THE"; N; "NUMBERS IS"; SUM/N
 99  END
